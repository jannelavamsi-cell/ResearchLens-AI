# =====================================================================
# ResearchLens AI Configuration
# Copy this file to .env and configure your desired settings
# =====================================================================

# LLM Provider: 'gemini' (default), 'ollama' (local), or 'openai' (compatible endpoint)
LLM_PROVIDER=gemini

# Google Gemini API Settings (Free tier available at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Ollama Settings (for 100% offline local privacy mode)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# OpenAI-Compatible Endpoint Settings (Groq, vLLM, DeepSeek, LocalAI, etc.)
OPENAI_API_KEY=your_openai_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Embedding Model (Sentence Transformers HuggingFace ID)
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_DEVICE=cpu

# Reranker Model (Cross-Encoder HuggingFace ID)
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
ENABLE_RERANKER=true

# Storage and Database Paths
DATABASE_PATH=data/researchlens.db
DATA_DIR=data
INDEX_DIR=data/indexes
UPLOAD_DIR=data/uploaded_papers

# Chunking & Retrieval Parameters
CHUNK_SIZE_TOKENS=350
CHUNK_OVERLAP_TOKENS=50
TOP_K_DENSE=15
TOP_K_BM25=15
TOP_K_RRF=20
TOP_K_FINAL=5

# Verification Settings
ENABLE_CITATION_VERIFIER=true
VERIFIER_THRESHOLD=0.85
